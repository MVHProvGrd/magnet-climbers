# URL of the deployed leaderboard Worker (see worker/). Leave unset to play without a global board.
VITE_LEADERBOARD_URL=https://magnet-climbers-api.<your-subdomain>.workers.dev

# Accounts (optional). The Firebase web config as one line of JSON; the game shows Google and
# Apple sign-in only when this is set. The Worker needs FIREBASE_PROJECT_ID to match.
# VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"<project>.firebaseapp.com","projectId":"<project>"}
