;; magnetclimbers.com — import in Cloudflare: DNS → Records → Import and Export → Import DNS records
;; Records are DNS-only (not proxied) so GitHub Pages can issue the TLS certificate.
$ORIGIN magnetclimbers.com.
$TTL 300

;; apex → GitHub Pages
@	300	IN	A	185.199.108.153
@	300	IN	A	185.199.109.153
@	300	IN	A	185.199.110.153
@	300	IN	A	185.199.111.153
@	300	IN	AAAA	2606:50c0:8000::153
@	300	IN	AAAA	2606:50c0:8001::153
@	300	IN	AAAA	2606:50c0:8002::153
@	300	IN	AAAA	2606:50c0:8003::153

;; www → GitHub Pages (GitHub redirects it to the apex)
www	300	IN	CNAME	mvhprovgrd.github.io.
